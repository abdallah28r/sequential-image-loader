{
  "manifest_version": 3,
  "name": "Sequential Image Loader",
  "version": "1.2.0",
  "description": "Loads page images one at a time instead of all in parallel, so slow image-heavy gallery pages become responsive again. Off by default; turn it on per site or per URL pattern.",
  "permissions": [
    "storage",
    "tabs",
    "favicon"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Sequential Image Loader",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "rules.js",
        "content.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}